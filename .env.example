# ── AI ──────────────────────────────────────────────────────────────
# Anthropic API key powering the META SUPREME X Council and agent network
ANTHROPIC_API_KEY=

# Model overrides — OPTIONAL. Leave unset to use the built-in defaults
# (primary claude-opus-4-8, utility claude-haiku-4-5; see MODELS in
# src/lib/ai/client.ts). Set a value only to intentionally pin a different
# model id. Council members and agents run on the primary tier;
# routing/summarization run on the utility tier.
# QO_MODEL_PRIMARY=
# QO_MODEL_UTILITY=

# ── Database (Supabase / Postgres) ─────────────────────────────────
# Apply src/lib/db/schema.sql to a Postgres 15+ database with pgvector
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (Stripe) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Automation (n8n) ───────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=
