# ── AI ──────────────────────────────────────────────────────────────
# Anthropic API key powering the META SUPREME X Council and agent network
ANTHROPIC_API_KEY=

# Model overrides — OPTIONAL. Leave unset to use the built-in defaults
# (primary claude-opus-4-8, utility claude-haiku-4-5; see MODELS in
# src/lib/ai/client.ts). Set a value only to intentionally pin a different
# model id. Council members and agents run on the primary tier;
# routing/summarization run on the utility tier.
# QO_MODEL_PRIMARY=
# QO_MODEL_UTILITY=

# ── Database (Supabase / Postgres) ─────────────────────────────────
# Apply src/lib/db/schema.sql to a Postgres 15+ database with pgvector
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (Stripe) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Operator buy button on /pricing. Public Payment Link — no secret required.
# Leave unset to use the live $49/month link in src/lib/billing/operator-checkout.ts.
# When STRIPE_SECRET_KEY is set, /pricing uses POST /api/billing/checkout instead.
# NEXT_PUBLIC_STRIPE_OPERATOR_PAYMENT_LINK=https://buy.stripe.com/5kQ28keGi7ti61KeUX04802
# Signing secret for /api/billing/webhook (starts `whsec_`). Without it the
# webhook refuses every request — that endpoint is public by necessity, so the
# signature is the only thing proving a call really came from Stripe.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs, one per paid plan. STRIPE_PRICE_OPERATOR is REQUIRED:
# /api/billing/checkout reads it and answers "Stripe Price ID missing" without
# it, so checkout cannot complete. It was read by the code and absent from this
# file — the kind of gap found in production rather than in review.
# The other two are optional; an unrecognised price falls back to the `operator`
# tier rather than guessing something more generous.
STRIPE_PRICE_OPERATOR=
STRIPE_PRICE_OPERATOR_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Automation (n8n) ───────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=
