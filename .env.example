# ── AI ──────────────────────────────────────────────────────────────
# Anthropic API key powering the META SUPREME X Council and agent network
ANTHROPIC_API_KEY=

# Model overrides (defaults shown; leave blank to use defaults)
# Council members and agents run on Opus; utility/summarization on Haiku
QO_MODEL_PRIMARY=claude-opus-4-8
QO_MODEL_UTILITY=claude-haiku-4-5

# ── Database (Supabase / Postgres) ─────────────────────────────────
# Apply src/lib/db/schema.sql to a Postgres 15+ database with pgvector
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (Stripe) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Automation (n8n) ───────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=
